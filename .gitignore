# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore master key for decrypting credentials and more.
/config/master.key
*.key
/config/environment_variables.yml

# The encrypted credentials file shipped without its key and nothing reads it;
# production takes SECRET_KEY_BASE from the environment instead.
/config/credentials.yml.enc

# Local environment files; .env.example documents the variables.
.env
.env.*
!.env.example

# Active Storage and other runtime files (not used, but never tracked).
/storage/*
!/storage/.keep

# Ignore locally vendored gems.
/vendor/bundle

# Ignore the SQLite database used by the test suite.
/db/*.sqlite3
/db/*.sqlite3-*

# Captured benchmark scratch files.
/tmp/benchmark/*

# A stray Python virtualenv that predates this repo's Ruby layout.
project_venv/
node_modules/

# Test, coverage and editor output.
/coverage
/spec/examples.txt
.DS_Store
.idea/
.vscode/
*.swp

# No hosted workflow configuration is kept in this repository.
.github/
