# Every variable is optional. docker compose reads this file as .env; the
# defaults below are what the stack uses when a value is left unset.

# Postgres credentials, shared by the db and app services.
DATABASE_NAME=translator_api_production
DATABASE_USERNAME=translator
DATABASE_PASSWORD=translator

# Required in production. The compose file falls back to a placeholder that is
# only fit for a local stack; generate a real one with `bin/rails secret`.
SECRET_KEY_BASE=

# Service knobs (see the README).
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_READS_PER_MINUTE=120
RATE_LIMIT_WRITES_PER_MINUTE=30
HIGHLIGHT_AUTOMATON_THRESHOLD=2500
